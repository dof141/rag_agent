# ===================== MINERU 配置 =====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
MD_ROOT_DIR=./temp-files/

# ===================== LLM / VL 大模型配置 =====================
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3.5-omni-plus-2026-03-15
# 请在下方填写您的 OpenAI / 阿里云百炼 API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://ws-5rzkq9e9xoimy6sd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1
ITEM_NAME_TIMEOUT_SECONDS=12
VLM_TIMEOUT=60
VLM_REQUESTS_PER_MINUTE=9
VLM_BATCH_SIZE=6
VLM_MAX_CONCURRENCY=3
VLM_CACHE_ENABLED=true
VLM_CACHE_PATH=output/cache/image_summaries.sqlite3
VLM_PROMPT_VERSION=v1

# ===================== Embedding 模型配置 =====================
# dashscope：调用阿里云百炼远程向量服务，不会加载本地 BGE-M3 模型
# local：加载本地 BGE-M3 模型，仅用于资源充足或离线部署
EMBEDDING_ADAPTER=dashscope
# DashScope 文本向量模型，支持稠密与稀疏向量输出
EMBEDDING_MODEL=qwen3.7-text-embedding
# 必须与 Milvus 集合中的稠密向量维度一致
EMBEDDING_DIMENSION=1024
EMBEDDING_OUTPUT_TYPE=dense&sparse
# 单次远程请求的最大文本条数
EMBEDDING_BATCH_SIZE=10
# 单次远程请求超时秒数
EMBEDDING_REQUEST_TIMEOUT=20
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 请填写阿里云百炼 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 仅当 EMBEDDING_ADAPTER=local 时读取以下本地兼容配置
BGE_M3_PATH=F:/ai_models/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
ITEM_NAME_DIAG=1

# ===================== Milvus 向量数据库配置 =====================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# ===================== Neo4j 图数据库配置 =====================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ===================== MongoDB 数据库配置 =====================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb002

# ===================== MinIO 对象存储配置 =====================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===================== 重排序模型配置 =====================
# http：调用兼容 POST /v1/rerank 的远程平台；local：加载本地 FlagEmbedding 模型
RERANKER_ADAPTER=http
# 默认使用硅基流动提供的免费多语言重排序模型
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
# 请填写硅基流动密钥；也可删除此项并使用 SILICONFLOW_API_KEY
RERANKER_API_KEY=your_siliconflow_api_key_here
# 超时后保留原始检索顺序继续回答，并向前端显示降级提示
RERANKER_REQUEST_TIMEOUT=8
# 单次发送到远程重排序平台的最大候选文档数
RERANKER_MAX_DOCUMENTS=20

# 仅当 RERANKER_ADAPTER=local 时读取以下本地兼容配置
BGE_RERANKER_LARGE=F:/ai_models/models/rerank/BAAI/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ===================== Qdrant 远程向量探针配置 =====================
# Qdrant Cloud 集群地址，例如 https://xxx.cloud.qdrant.io:6333
QDRANT_URL=
# Qdrant Cloud API Key，不要提交真实密钥
QDRANT_API_KEY=
# 硅基流动 API Key；未设置时探针兼容读取上面的 RERANKER_API_KEY
SILICONFLOW_API_KEY=
# 硅基流动 OpenAI-compatible 接口地址
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 免费 dense 向量模型，硅基流动当前接口只返回 dense 向量
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# BAAI/bge-m3 的 dense 向量维度
SILICONFLOW_EMBEDDING_DIMENSION=1024
# 单次远程向量请求超时秒数
SILICONFLOW_EMBEDDING_TIMEOUT=20
# Qdrant Cloud 服务端稀疏向量模型
QDRANT_BM25_MODEL=Qdrant/bm25
# 必须开启，探针依赖 Qdrant Cloud Inference 生成 BM25 sparse 向量
QDRANT_CLOUD_INFERENCE=true
# 探针专用 collection；重复运行会删除并重建这个 collection
QDRANT_PROBE_COLLECTION=rag_remote_vector_probe

# ===================== MCP 搜索配置 =====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===================== MinerU API 配置 =====================
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== 日志配置 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=ERROR
LOG_FILE_RETENTION=7 days
